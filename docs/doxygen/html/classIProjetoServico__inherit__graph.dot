digraph "IProjetoServico"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="IProjetoServico",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Interface para serviços relacionados a Projeto."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="ProjetoServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classProjetoServico.html",tooltip="Serviço real responsável pelas operações de Projeto."];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="StubProjetoServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStubProjetoServico.html",tooltip="Stub de serviços de projeto."];
}
