  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="StubPessoaServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStubPessoaServico.html",tooltip="Stub de serviços de pessoa."];
