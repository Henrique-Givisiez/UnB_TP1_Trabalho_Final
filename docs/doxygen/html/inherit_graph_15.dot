  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="ProjetoServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classProjetoServico.html",tooltip="Serviço real responsável pelas operações de Projeto."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
