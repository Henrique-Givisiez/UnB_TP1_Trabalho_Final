digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="IAuthServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classIAuthServico.html",tooltip="Interface responsável pelos serviços de autenticação."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="AuthServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classAuthServico.html",tooltip="Serviço real responsável pela autenticação de usuários."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="StubAuthServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStubAuthServico.html",tooltip="Stub de autenticação."];
}
