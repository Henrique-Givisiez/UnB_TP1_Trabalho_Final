digraph "IAuthServico"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="IAuthServico",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Interface responsável pelos serviços de autenticação."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="AuthServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classAuthServico.html",tooltip="Serviço real responsável pela autenticação de usuários."];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="StubAuthServico",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStubAuthServico.html",tooltip="Stub de autenticação."];
}
